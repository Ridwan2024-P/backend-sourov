PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string, e.g.:
#   postgres://user:password@localhost:5432/guts_wear
# For local dev with the included docker-compose.yml, this matches it out of the box.
DATABASE_URL=postgres://guts_wear:guts_wear@localhost:5432/guts_wear

# Set to "true" if your Postgres provider requires SSL and DATABASE_URL doesn't
# already include ?sslmode=require (most managed hosts — Render, Railway, Supabase,
# Neon, RDS — need this; a local docker/native Postgres does not).
PGSSL=false
